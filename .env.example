# ==============================================================================
# Application Settings
# ==============================================================================
PROJECT_NAME="News Article Management & Summarization API"
ENVIRONMENT="development"
DEBUG=True
PORT=8000
HOST="127.0.0.1"
API_V1_STR="/api/v1"

# ==============================================================================
# PostgreSQL Database Configuration
# ==============================================================================
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=simprosys_test

# Async SQLAlchemy connection URL (used by FastAPI async endpoints via asyncpg)
DATABASE_URL=postgresql+asyncpg://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# Sync SQLAlchemy connection URL (used by Celery background worker via psycopg2)
SYNC_DATABASE_URL=postgresql+psycopg2://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# ==============================================================================
# Redis & Celery Message Broker Configuration
# ==============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/0

# Celery Broker and Result Backend URLs
CELERY_BROKER_URL=redis://${REDIS_HOST}:${REDIS_PORT}/0
CELERY_RESULT_BACKEND=redis://${REDIS_HOST}:${REDIS_PORT}/0

# Set to True for testing or to execute tasks synchronously without a worker
CELERY_TASK_ALWAYS_EAGER=False
